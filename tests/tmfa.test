    tmfa::get_hotp $secret 9223372036854775807 10 SHA256
} -result 1369076418

test hotp-wide-9223372036854775807-SHA512 {Unsigned 64-bit counter; Python hmac reference} -body {
    tmfa::get_hotp $secret 9223372036854775807 10 SHA512
} -result 1470447857

test hotp-wide-18446744073709551615-SHA1 {Unsigned 64-bit counter; Python hmac reference} -body {
    tmfa::get_hotp $secret 18446744073709551615 10 SHA1
} -result 1663094451

test hotp-wide-18446744073709551615-SHA256 {Unsigned 64-bit counter; Python hmac reference} -body {
    tmfa::get_hotp $secret 18446744073709551615 10 SHA256
} -result 0027790413

test hotp-wide-18446744073709551615-SHA512 {Unsigned 64-bit counter; Python hmac reference} -body {
    tmfa::get_hotp $secret 18446744073709551615 10 SHA512
} -result 1111381515

test hotp-binary {Binary secret including NUL; Python hmac reference} -body {
    set bytes {}
    for {set i 0} {$i < 256} {incr i} {append bytes [binary format c $i]}
    tmfa::get_hotp [tmfa::base32_encode $bytes] 42 8 SHA256
} -result 33745326

::tcltest::cleanupTests
